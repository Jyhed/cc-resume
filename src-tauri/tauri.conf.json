{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "CC-Resume",
  "version": "0.2.1",
  "identifier": "com.jihed.ccresume",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "CC-Resume",
        "width": 1240,
        "height": 800,
        "minWidth": 1000,
        "minHeight": 660,
        "center": true,
        "resizable": true,
        "decorations": false,
        "shadow": true,
        "visible": false,
        "backgroundColor": "#0d0d0e"
      }
    ],
    "security": {
      "csp": "default-src 'self' ipc: http://ipc.localhost; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; connect-src ipc: http://ipc.localhost",
      "devCsp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "shortDescription": "Every Claude Code chat on this PC, one click from its terminal",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
